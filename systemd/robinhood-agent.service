[Unit]
Description=Robinhood autonomous trading agent (single run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust User and paths to your setup before installing.
User=%i
WorkingDirectory=/home/%i/robinhood
ExecStart=/home/%i/robinhood/scripts/run-agent.sh
# API key auth (skip if you used `claude setup-token` interactively instead):
EnvironmentFile=-/home/%i/robinhood/.env
TimeoutStartSec=25min
