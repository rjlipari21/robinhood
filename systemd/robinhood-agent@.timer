[Unit]
Description=Run the Robinhood trading agent for %i during regular market hours

[Timer]
# Every 30 minutes across Robinhood's REGULAR session only, 09:30-16:00 ET
# Mon-Fri: 09:30, 10:00, 10:30, ... 15:30. Thirteen runs per trading day.
#
# Narrowed on 2026-09-01 from "every 15 min, 07:00-20:00 ET" (~52 runs/day).
# Measured Claude spend at that cadence was $2.57/run, ~$134/day against a
# ~$1,000 account. Cadence is the bluntest lever on that bill -- it is pure
# multiplication -- and the mandate already expects most runs to place zero
# orders. Combined with the Haiku 4.5 pin in run-agent.sh, the first run after
# the turn-count refactor measured $1.22 on Sonnet 5 / 27 turns, which is ~$0.61
# at Haiku rates -- about $8/day, down from ~$134.
#
# The overnight 24 Hour Market window is not covered, and neither are the
# pre-market and post-market extended sessions any more. The session gate in
# run-agent.sh is the authoritative check and skips anything this timer lets
# through outside 09:30-16:00 ET.
#
# Expressed in America/New_York so DST needs no maintenance. Two lines because
# 09:30 is not on a :00/:30 boundary from 09:00 -- systemd unions multiple
# OnCalendar= entries, so this yields 09:30 plus 10:00-15:30 every 30 min
# without also firing at 09:00 pre-market.
OnCalendar=Mon..Fri 09:30 America/New_York
OnCalendar=Mon..Fri 10..15:00/30 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
