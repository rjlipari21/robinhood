[Unit]
Description=Run the Robinhood trading agent for %i during regular/extended hours

[Timer]
# Every 15 minutes across Robinhood's regular + extended sessions, 07:00-20:00
# ET Mon-Fri. The overnight 24 Hour Market window is deliberately NOT covered
# any more -- see the session gate in run-agent.sh, which is the authoritative
# check and skips anything this timer lets through outside those hours.
#
# Expressed in America/New_York so DST needs no maintenance: hours 07..19,
# minutes 00/15/30/45, giving a last run at 19:45 ET.
#
# COST: ~52 invocations per trading day, each a `claude -p` run. Verify actual
# spend after the first day before leaving it unattended.
#
# A run that outlives its window does not stack: run-agent.sh takes a
# non-blocking flock and exits when a run is already in flight. Without that,
# systemd would queue a follow-up job for every fire and the agent would run
# back-to-back forever.
OnCalendar=Mon..Fri 07..19:00/15:00 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
